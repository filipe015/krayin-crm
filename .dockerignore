# Keep history out of the image.
# .env must NOT be listed here: Krayin shows its installer when there is no .env file,
# and Easypanel ("Create env file") generates one in the build context that has to reach the image.
.git

# Rebuilt inside the image
node_modules
vendor

# Local dev leftovers
**/*.log
storage/framework/sessions/[A-Za-z0-9]*
.idea
.vscode
.claude
.cursor
.codex
.kilocode
.ai
.DS_Store
